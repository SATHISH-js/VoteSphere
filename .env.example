# ==============================================================================
# PulsePoll — Production & Local Environment Configuration
# ==============================================================================

# --- Backend Configuration (Go / Gin) ---
PORT=8080
GIN_MODE=debug # 'debug' in development, 'release' in production

# MongoDB Connection String (Local or MongoDB Atlas cluster URI)
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=pulsepoll

# Redis Connection URL (Local or Redis Cloud / Upstash)
# Local: redis://localhost:6379
# Cloud: rediss://default:<password>@<host>:<port>
REDIS_URL=redis://localhost:6379

# JWT Authentication Secret Key (minimum 32 characters)
JWT_SECRET=pulsepoll-production-secret-key-change-in-prod-32bytes

# Allowed CORS Frontend URL
FRONTEND_URL=http://localhost:5173

# --- Frontend Configuration (React / Vite) ---
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080
